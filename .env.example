BOT_TOKEN=1234567890:PASTE_YOUR_TELEGRAM_BOT_TOKEN
BOT_PROXY=socks5://127.0.0.1:10808

# Роли. Если новые списки заполнены, пользователь вне списков не получит доступ.
# admin: каталог + склад + импорт; manager: склад; viewer: только просмотр.
ADMIN_USER_IDS=
MANAGER_USER_IDS=
VIEWER_USER_IDS=

# Обратная совместимость с v1.1.0: если новые роли пусты, эти ID считаются admin.
# Если и ALLOWED_USER_IDS пуст, сохраняется открытый режим для всех.
ALLOWED_USER_IDS=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://foundation-models.api.cloud.ru/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Pro
OPENAI_PROXY=

PRODUCT_MCP_DB_PATH=./data/products.sqlite3
BACKUP_DIR=./backups
BACKUP_KEEP=14
BACKUP_INCLUDE_ENV=false

# ProductFlow AI notifications
NOTIFICATIONS_ENABLED=true
# Если пусто, уведомления получают ADMIN_USER_IDS
NOTIFICATION_USER_IDS=
NOTIFICATION_INTERVAL_SECONDS=300
DAILY_REPORT_HOUR_UTC=6

# ProductFlow AI v1.4 security
SECURITY_RATE_LIMIT_PER_MINUTE=60

# ProductFlow Web Admin / REST API v1.6.0
# Keep WEB_HOST=127.0.0.1 until a TLS reverse proxy is configured.
WEB_HOST=127.0.0.1
WEB_PORT=8090
WEB_ADMIN_PASSWORD=
WEB_API_KEY=
WEB_SESSION_SECRET=
WEB_SESSION_HOURS=12
WEB_COOKIE_SECURE=false
